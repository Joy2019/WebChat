COZE_API_TOKEN=你的_Personal_Access_Token
COZE_BOT_ID=你的_Coze_机器人ID
COZE_REGION=com

# 可选：新建会话时的 AI 开场白（优先级高于 public/config.json 的 openingMessage）
# OPENING_MESSAGE=你好，我是你的 AI 助手……
# HTTPS 3000 = 手机浏览器 + 语音；HTTP 3001 = API/调试（页面 GET 自动跳转 HTTPS）
HTTPS_PORT=3000
HTTP_PORT=3001
PORT=3001

# 生产环境（Nginx 443 反代）：关闭 Node HTTPS 与 HTTP→HTTPS 跳转
# ENABLE_HTTPS=0
# BEHIND_NGINX=1
# HOST=127.0.0.1
# PUBLIC_URL=https://aigckzsy.sebri.cn
# PUBLIC_HTTPS_PORT=443
# DISABLE_HTTP_TO_HTTPS_REDIRECT=1

# 图片上传失败：响应含 debug，并写入 logs/upload-YYYY-MM-DD.log
DEBUG_UPLOAD=1

# 免费公网 HTTPS（先 localtunnel，失败自动试 cloudflared）
ENABLE_LOCALTUNNEL=1
# ENABLE_CLOUDFLARED=1
# TUNNEL_SUBDOMAIN=

# 阿里云智能语音交互 · 一句话识别（大陆可用，语音输入 🎤 服务端 STT）
# 控制台：https://nls-portal.console.aliyun.com/
# 1. 登录阿里云 → 智能语音交互 → 创建项目 → 复制 AppKey
# 2. RAM 或主账号 AccessKey：控制台右上角头像 → AccessKey 管理（需 CreateToken 权限）
# 3. 项目需开通「一句话识别」；默认地域 cn-shanghai，可改 ALIYUN_NLS_REGION
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=  # RAM Secret（约30位），勿填 sk- 开头的 DashScope Key
ALIYUN_NLS_APP_KEY=
# ALIYUN_NLS_REGION=cn-shanghai

# ===== Web 语音对话（LiveKit AI 语音助手，点击会话/话题进入）=====
# 接入端由语音助手管理员开通；密钥仅放服务端，前端通过 GET /api/voice/token 取短时 JWT
# VA_CLIENT_ID=cxxxxxxxxxxxxxxxx
# VA_ACCESS_KEY=va_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VA_TOKEN_URL=https://10.63.7.246:8443/token
# VA_LIVEKIT_WS_URL=wss://10.63.7.246:8443
# 内网自签证书调 /token 时可开（仅开发）：VA_TOKEN_INSECURE_TLS=1
# VA_TOKEN_TIMEOUT_MS=8000

# IMGBB_API_KEY=
